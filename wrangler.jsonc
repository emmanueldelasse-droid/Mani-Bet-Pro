{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "manibetpro",
  "main": "worker.js",
  "compatibility_date": "2026-04-19",
  "observability": {
    "enabled": true
  },
  "version_metadata": {
    "binding": "CF_VERSION_METADATA"
  },
  "assets": {
    "directory": ".",
    "binding": "ASSETS"
  },
  "kv_namespaces": [
    {
      "binding": "PAPER_TRADING",
      "id": "17eb7ddc41a949dd99bd840142832cfd"
    }
  ],
  "d1_databases": [
    {
      "binding": "MANI_HISTORY_DB",
      "database_name": "manibetpro-history",
      "database_id": "cf8e609e-e1d2-4a0d-b879-32b79349a47a",
      "migrations_dir": "migrations"
    }
  ],
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "triggers": {
    "crons": ["0 * * * *", "*/15 * * * *"]
  }
}
